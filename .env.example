# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno (Vercel → Settings → Environment Variables)
# Copia a .env.local para desarrollo. NINGUNA usa prefijo VITE_ → NO se exponen
# en el bundle del cliente; solo las leen las funciones serverless de /api.
# Sin estas variables la web sigue funcionando con datos de respaldo.
# ─────────────────────────────────────────────────────────────────────────────

# Google Places API (New) — reseñas reales en tiempo real
# 1) https://console.cloud.google.com/ → habilita "Places API (New)"
# 2) Crea una API key y restríngela (por API y/o IP del servidor)
# 3) Obtén el Place ID de tu ficha de Google Maps (Place ID Finder o resolviendo
#    el link share en un navegador y copiando el identificador del lugar)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Panel Admin — auth de servidor (OBLIGATORIO para acceder al panel)
# Sin estas dos variables el panel queda bloqueado (no hay login posible).
# ADMIN_PASSWORD: la contraseña del dueño (cámbiala, no uses una débil).
# ADMIN_SESSION_SECRET: cadena larga y aleatoria para firmar la sesión.
#   Genera una con:  openssl rand -base64 32   (o cualquier string >32 chars)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Reservas por correo (serverless)
# Recomendado: Resend. Crea una API key y, para producción, verifica un dominio.
# BOOKING_TO_EMAIL: correo destino donde llegan las solicitudes.
# BOOKING_FROM_EMAIL: remitente verificado en Resend.
# Para prueba puedes usar onboarding@resend.dev. Para producción verifica un
# dominio propio y usa algo como Transporte Ovando <reservas@tudominio.com>.
# No uses gmail.com como remitente en Resend.
RESEND_API_KEY=
BOOKING_TO_EMAIL=transporteovando@gmail.com
BOOKING_FROM_EMAIL=Transporte Ovando <onboarding@resend.dev>

# Instagram Graph API (opcional) — feed automático de últimos posts
# Requiere cuenta Business/Creator vinculada a una app de Meta y un token
# long-lived. Sin token se usan las fotos de src/data/instagramPosts.js
INSTAGRAM_ACCESS_TOKEN=
