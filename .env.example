# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno (Vercel → Settings → Environment Variables)
# Copia a .env.local para desarrollo. NINGUNA usa prefijo VITE_ → NO se exponen
# en el bundle del cliente; solo las leen las funciones serverless de /api.
# Sin estas variables la web sigue funcionando con datos de respaldo.
# ─────────────────────────────────────────────────────────────────────────────

# Google Places API (New) — reseñas reales en tiempo real
# 1) https://console.cloud.google.com/ → habilita "Places API (New)"
# 2) Crea una API key y restríngela (por API y/o IP del servidor)
# 3) Obtén el Place ID de tu ficha de Google Maps (Place ID Finder o resolviendo
#    el link share en un navegador y copiando el identificador del lugar)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Instagram Graph API (opcional) — feed automático de últimos posts
# Requiere cuenta Business/Creator vinculada a una app de Meta y un token
# long-lived. Sin token se usan las fotos de src/data/instagramPosts.js
INSTAGRAM_ACCESS_TOKEN=
